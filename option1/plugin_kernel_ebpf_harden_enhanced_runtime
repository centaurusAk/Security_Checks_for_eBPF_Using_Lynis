#!/bin/sh
################################-------------
# PLUGIN_AUTHOR=Neerav Ahuja
# PLUGIN_CATEGORY=EBF security
# PLUGIN_DESC=State aware checks for Linux eBPF JIT hardening and unprivileged eBPF
# PLUGIN_NAME=kernel_ebpf_harden_enhanced_runtime
# PLUGIN_REQUIRED_TESTS=
#############################################

InsertSection "Linux Kernel eBPF Security - Enhancement First Option "

# Enhancement option 1: make the baseline runtime checks state-aware.
# Use sysctl -n so parsing does not depend on localized command output.
# Distinguish secure, partially hardened, insecure, unsupported and unknown states.

EBPF_SYSCTL=""
if [ -n "${SYSCTLBINARY:-}" ] && [ -x "${SYSCTLBINARY}" ]; then
    EBPF_SYSCTL="${SYSCTLBINARY}"
else
    EBPF_SYSCTL=$(command -v sysctl 2>/dev/null)
fi

ebpf_read_runtime() {
    if [ -z "${EBPF_SYSCTL}" ]; then
        return 127
    fi
    "${EBPF_SYSCTL}" -n "$1" 2>/dev/null
}

# Test 1: net.core.bpf_jit_harden: 0=off, 1=unprivileged users, 2=all users.
Register --test-no KRNL-EBPF-0001 --os Linux --weight H --network NO --category security --description "Check eBPF JIT hardening"
if [ "${SKIPTEST:-0}" -eq 0 ]; then
    LogText "Test: Checking runtime net.core.bpf_jit_harden"
    if [ -z "${EBPF_SYSCTL}" ]; then
        LogText "Result: sysctl utility unavailable; runtime value cannot be assessed"
        Display --indent 2 --text "Checking eBPF JIT hardening status" --result "UNKNOWN" --color YELLOW
        ReportSuggestion "KRNL-EBPF-0001" "The 'sysctl' tool is missing on this system. Please restore it or manually inspect the value in '/proc/sys/net/core/bpf_jit_harden'."
    else
        EBPF_VALUE=$(ebpf_read_runtime net.core.bpf_jit_harden)
        EBPF_RC=$?
        if [ "${EBPF_RC}" -ne 0 ] || [ -z "${EBPF_VALUE}" ]; then
            LogText "Result: net.core.bpf_jit_harden unavailable or unsupported by this kernel"
            Display --indent 2 --text "Checking eBPF JIT hardening status" --result "NOT SUPPORTED" --color YELLOW
        else
            case "${EBPF_VALUE}" in
                0)
                    LogText "Result: net.core.bpf_jit_harden=0; JIT hardening is disabled"
                    Display --indent 2 --text "eBPF JIT hardening is currently turned off" --result "WARNING" --color YELLOW
                    ReportSuggestion "KRNL-EBPF-0001" "We recommend setting 'net.core.bpf_jit_harden=2' to significantly improve security against JIT spraying, as long as it fits your application requirements."
                    ;;
                1)
                    LogText "Result: net.core.bpf_jit_harden=1; JIT hardening applies to unprivileged users"
                    Display --indent 2 --text "eBPF JIT hardening is active only for unprivileged users" --result "PARTIAL" --color YELLOW
                    ReportSuggestion "KRNL-EBPF-0001" "Consider upgrading to 'net.core.bpf_jit_harden=2' to enforce hardening across all users, after verifying compatibility with your workloads."
                    ;;
                2)
                    LogText "Result: net.core.bpf_jit_harden=2; JIT hardening applies to all users"
                    Display --indent 2 --text "eBPF JIT hardening is fully enabled for everyone" --result "SECURE" --color GREEN
                    ;;
                *)
                    LogText "Result: unexpected net.core.bpf_jit_harden value '${EBPF_VALUE}'"
                    Display --indent 2 --text "Checking eBPF JIT hardening status" --result "UNKNOWN" --color YELLOW
                    ReportSuggestion "KRNL-EBPF-0001" "An unexpected value ('${EBPF_VALUE}') was returned. Please cross-check it against your kernel version documentation."
                    ;;
            esac
        fi
    fi
fi

# Test 2: kernel.unprivileged_bpf_disabled: 0=allowed, 1/2=disabled.
Register --test-no KRNL-EBPF-0002 --os Linux --weight H --network NO --category security --description "Check unprivileged eBPF restriction"
if [ "${SKIPTEST:-0}" -eq 0 ]; then
    LogText "Test: Checking runtime kernel.unprivileged_bpf_disabled"
    if [ -z "${EBPF_SYSCTL}" ]; then
        LogText "Result: sysctl utility unavailable; runtime value cannot be assessed"
        Display --indent 2 --text "Checking unprivileged eBPF access restrictions" --result "UNKNOWN" --colorYELLOW
        ReportSuggestion "KRNL-EBPF-0002" "The 'sysctl' tool is missing. Please restore it or manually check '/proc/sys/kernel/unprivileged_bpf_disabled'."
    else
        EBPF_VALUE=$(ebpf_read_runtime kernel.unprivileged_bpf_disabled)
        EBPF_RC=$?
        if [ "${EBPF_RC}" -ne 0 ] || [ -z "${EBPF_VALUE}" ]; then
            LogText "Result: kernel.unprivileged_bpf_disabled unavailable or unsupported by this kernel"
            Display --indent 2 --text "Checking unprivileged eBPF access restrictions" --result "NOT SUPPORTED" --color YELLOW
        else
            case "${EBPF_VALUE}" in
                0)
                    LogText "Result: kernel.unprivileged_bpf_disabled=0; unprivileged eBPF is allowed"
                    Display --indent 2 --text "Unprivileged users are currently allowed to load eBPF programs" --result "WARNING" --color YELLOW
                    ReportSuggestion "KRNL-EBPF-0002" "To minimize attack surface, set 'kernel.unprivileged_bpf_disabled=1' (or '2') once you confirm your apps don't rely on unprivileged eBPF."
                    ;;
                1)
                    LogText "Result: kernel.unprivileged_bpf_disabled=1; unprivileged eBPF is disabled in strict mode"
                    Display --indent 2 --text "Unprivileged eBPF is safely disabled in strict mode" --result "SECURE" --color GREEN
                    ;;
                2)
                    LogText "Result: kernel.unprivileged_bpf_disabled=2; unprivileged eBPF is disabled by default"
                    Display --indent 2 --text "Unprivileged eBPF is disabled by default (can be overridden)" --result "SECURE" --color GREEN
                    ReportSuggestion "KRNL-EBPF-0002" "Note that value '2' can be toggled back by a privileged process. If you need permanent lockdown, consider setting value '1'."
                    ;;
                *)
                    LogText "Result: unexpected kernel.unprivileged_bpf_disabled value '${EBPF_VALUE}'"
                    Display --indent 2 --text "Checking unprivileged eBPF access restrictions" --result "UNKNOWN" --color YELLOW
                    ReportSuggestion "KRNL-EBPF-0002" "An unexpected value ('${EBPF_VALUE}') was returned. Please verify it against your kernel documentation."
                    ;;
            esac
        fi
    fi
fi

WaitForKeyPress
#EOF
